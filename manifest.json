{
  "schemaVersion": 1,
  "id": "mcx424.market-hours",
  "name": "Market Hours",
  "version": "1.0.1",
  "author": "McX424",
  "description": "Equity session clock for the Omarchy bar \u2014 NYSE, NASDAQ, LSE, TSE, ASX, NZX. Clock only \u2014 no quotes.",
  "license": "MIT",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Market Hours",
    "category": "Markets",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "displayTimezone": "America/New_York",
      "showCountdown": true,
      "countDownToPre": false,
      "usPreStart": "04:00",
      "usRegularOpen": "09:30",
      "usRegularClose": "16:00",
      "usAhEnd": "20:00",
      "tickSeconds": 30
    },
    "schema": [
      {
        "key": "displayTimezone",
        "type": "string",
        "label": "Display timezone (IANA)"
      },
      {
        "key": "showCountdown",
        "type": "bool",
        "label": "Show countdown"
      },
      {
        "key": "countDownToPre",
        "type": "bool",
        "label": "Count down to pre-market instead of regular open"
      },
      {
        "key": "usPreStart",
        "type": "string",
        "label": "US pre-market start (ET, HH:MM)"
      },
      {
        "key": "usRegularOpen",
        "type": "string",
        "label": "US regular open (ET, HH:MM)"
      },
      {
        "key": "usRegularClose",
        "type": "string",
        "label": "US regular close (ET, HH:MM)"
      },
      {
        "key": "usAhEnd",
        "type": "string",
        "label": "US after-hours end (ET, HH:MM)"
      },
      {
        "key": "tickSeconds",
        "type": "number",
        "label": "Refresh seconds"
      }
    ]
  }
}
